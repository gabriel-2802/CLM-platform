# ==============================================================================
# TESTING / DEVELOPMENT ENVIRONMENT
# Safe defaults for local development — commit this file to version control.
# Do NOT use these values in production.
# ==============================================================================

# --- Main database ---
DB_USER=clm_user
DB_PASSWORD=clm_password_dev
DB_NAME=clm_platform
DB_PORT=5432
DB_EXPOSE_PORT=5433         # host port mapped to postgres (connect via localhost:5433)

# --- Users database (user-service only) ---
DB_USERS_NAME=clm_users
DB_USERS_EXPOSE_PORT=5434   # host port mapped to postgres-users (connect via localhost:5434)

# --- Clients database (client-service only) ---
DB_CLIENTS_NAME=clm_clients
DB_CLIENTS_EXPOSE_PORT=5435 # host port mapped to postgres-clients (connect via localhost:5435)

# --- JWT ---
# JWT_SECRET and NEXTAUTH_SECRET MUST be the same value.
# NextAuth signs session tokens with NEXTAUTH_SECRET; contracts validates them with JWT_SECRET.
# Must be at least 64 characters in production — this value is for dev only.
JWT_SECRET=dev-shared-jwt-secret-used-by-both-nextauth-and-spring-change-before-deploy
JWT_EXPIRATION=2592000000   # 30 days in milliseconds

# --- Admin ---
ADMIN_REGISTER_CODE=devcode123
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Admin

# --- Mail / SMTP (Mailtrap sandbox — no real emails sent) ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@dev.example.com
EMAIL_VERIFICATION_EXPIRATION=86400000   # 24 hours in milliseconds

# --- Application URLs ---
# All external traffic goes through Nginx on https://localhost
FRONTEND_URL=https://localhost
CONTRACTS_SERVICE_URL=http://contracts:8081
NOTIFICATIONS_SERVICE_URL=http://notifications:8082

# --- Next.js Public API URLs (resolved in the browser — all via Nginx now) ---
NEXT_PUBLIC_API_BASE_URL=https://localhost
NEXT_PUBLIC_CONTRACTS_API_URL=https://localhost/api/contracts
NEXT_PUBLIC_NOTIFICATIONS_API_URL=https://localhost/api/notifications
NEXT_PUBLIC_USER_SERVICE_URL=https://localhost/api/users
NEXT_PUBLIC_CLIENT_SERVICE_URL=https://localhost/api/clients

# --- NextAuth ---
# Must equal JWT_SECRET — see comment above
NEXTAUTH_SECRET=dev-shared-jwt-secret-used-by-both-nextauth-and-spring-change-before-deploy
NEXTAUTH_URL=https://localhost

# --- LibreOffice ---
LIBREOFFICE_PATH=/usr/bin/libreoffice

# --- Monitoring ---
# Prometheus is internal only (data-net). Access via Grafana at https://localhost/grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=Admin123!

# --- Spring ---
SPRING_PROFILES_ACTIVE=test

# --- Node ---
NODE_ENV=development
