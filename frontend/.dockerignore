# version control
.git
.gitignore

# dependencies — reinstalled inside the container
node_modules
.pnp
.pnp.js

# next.js build output — rebuilt inside the container
.next
out

# env files — injected via docker compose at runtime
.env
.env.*
!.env.example

# prisma — removed from project
prisma

# dev tooling — not needed in the image
.eslintrc*
.prettierrc*
*.config.ts
*.config.js
!next.config.ts

# ide and os
.idea
.vscode
*.iml
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# testing
coverage
.nyc_output
__tests__
*.test.ts
*.spec.ts

# typescript build info
*.tsbuildinfo
next-env.d.ts

# ci and docs
.github
*.md
