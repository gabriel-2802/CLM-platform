# ==============================================================================
# PRODUCTION SECRETS — copy this file to .env.secrets and fill in real values.
# .env.secrets is git-ignored and MUST NOT be committed.
#
# Used only by:  bash scripts/secrets-init.sh production
# After running that script these values are stored in the Docker Swarm keystore
# and this file can be deleted or kept off-server entirely.
# ==============================================================================

# Database password (shared across all postgres instances)
SECRET_DB_PASSWORD=

# JWT signing secret — MUST match NEXTAUTH_SECRET
SECRET_JWT_SECRET=

# NextAuth signing secret — MUST equal JWT_SECRET
SECRET_NEXTAUTH_SECRET=

# Admin user bootstrap credentials
SECRET_ADMIN_PASSWORD=
SECRET_ADMIN_REGISTER_CODE=

# SMTP credentials
SECRET_MAIL_USERNAME=
SECRET_MAIL_PASSWORD=

# Grafana admin password
SECRET_GRAFANA_PASSWORD=

# Paths to TLS certificate and private key on this host
TLS_CERT_FILE=/etc/ssl/certs/clm.crt
TLS_KEY_FILE=/etc/ssl/private/clm.key
