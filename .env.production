# ==============================================================================
# PRODUCTION ENVIRONMENT
# This file is git-ignored. Never commit it.
#
# CHECKLIST before running `make prod`:
#   [ ] All values marked REQUIRED are filled in
#   [ ] JWT_SECRET and NEXTAUTH_SECRET are THE SAME value, at least 64 random chars
#       Generate once:  openssl rand -hex 32
#       Paste the same output into both JWT_SECRET and NEXTAUTH_SECRET below
#   [ ] DB_PASSWORD is strong and unique (never reuse a dev value)
#   [ ] FRONTEND_URL is your real public domain, e.g. https://clm.example.com
#   [ ] MAIL_* points to a real SMTP provider (not Mailtrap sandbox)
#   [ ] next.config.ts has output: "standalone" (already done by make setup-standalone)
# ==============================================================================

# --- Database ---
DB_USER=clm_user
# REQUIRED — strong unique password:
DB_PASSWORD=
DB_NAME=clm_platform
DB_PORT=5432

# --- JWT ---
# REQUIRED — must equal NEXTAUTH_SECRET below. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=2592000000

# --- Admin ---
# REQUIRED — change from any dev/test value:
ADMIN_REGISTER_CODE=

# --- Mail / SMTP ---
# REQUIRED — real SMTP provider (SendGrid, SES, Postmark, etc.):
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_EXPIRATION=86400000

# --- Application URLs ---
# REQUIRED — your public domain, used for CORS + NextAuth:
FRONTEND_URL=
# Internal Docker network addresses — do not change:
CONTRACTS_SERVICE_URL=http://contracts:8081
NOTIFICATIONS_SERVICE_URL=http://notifications:8082

# --- Host-side ports ---
# Only the client is exposed; put Nginx / Caddy in front:
CLIENT_PORT=3000

# --- Next.js Public API URLs (resolved in end-user browsers) ---
# REQUIRED — must be reachable from the internet:
NEXT_PUBLIC_CONTRACTS_API_URL=
NEXT_PUBLIC_NOTIFICATIONS_API_URL=

# --- NextAuth ---
# REQUIRED — must equal JWT_SECRET above (same generated value):
NEXTAUTH_SECRET=
# REQUIRED — same value as FRONTEND_URL:
NEXTAUTH_URL=

# --- LibreOffice ---
LIBREOFFICE_PATH=/usr/bin/libreoffice

# --- Spring / Node ---
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production
