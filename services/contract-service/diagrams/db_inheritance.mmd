---
title: JOINED Inheritance — Database Table Layout
---
flowchart TB
    subgraph DB["PostgreSQL clm schema"]
        subgraph BASE["clm.document  (base table)"]
            B1["id BIGSERIAL PK\ndocument_type VARCHAR(31) discriminator\ntemplate_id FK nullable\ndocument_format ENUM\ndocument_content BYTEA\nsigned_document_content BYTEA\ngenerated_by INTEGER\ngenerated_by_mail\nnotes VARCHAR(1000)\ncreated_at TIMESTAMP"]
        end

        subgraph CONTRACT["clm.contract  (subclass)"]
            C1["document_id BIGINT PK + FK→document.id\nclient_id INTEGER\ncontract_status ENUM\ncontract_value NUMERIC\ncontract_balance NUMERIC\nauto_renew BOOLEAN\ncontract_start_date DATE\ncontract_end_date DATE\ntermination_date DATE\nreasons_for_termination\n───── AUDIT ─────\ngenerated_at TIMESTAMP\ngenerated_by_user_id INTEGER\nuploaded_signed_at TIMESTAMP\nuploaded_signed_by_user_id INTEGER\nterminated_at TIMESTAMP\nterminated_by_user_id INTEGER"]
        end

        subgraph APPENDIX["clm.appendix  (subclass)"]
            A1["document_id BIGINT PK + FK→document.id\ncontract_id BIGINT FK→contract.document_id\ntitle VARCHAR(255)\nappendix_status ENUM"]
        end

        subgraph DFV["clm.document_field_value  (audit log)"]
            D1["id BIGSERIAL PK\ndocument_id BIGINT FK→document.id\ntemplate_field_id BIGINT FK→template_field.id\nfield_value TEXT\ncreated_at TIMESTAMP"]
        end

        BASE -->|"document_id = document.id\nON DELETE CASCADE"| CONTRACT
        BASE -->|"document_id = document.id\nON DELETE CASCADE"| APPENDIX
        BASE -->|"document_id FK\nON DELETE CASCADE"| DFV
    end

    JPA["JPA Layer\nInheritanceType.JOINED\n@DiscriminatorColumn(document_type)\n@DiscriminatorValue('CONTRACT')\n@DiscriminatorValue('APPENDIX')"]
    JPA -->|"SELECT d.*, c.*\nFROM document d\nJOIN contract c\nON c.document_id = d.id"| CONTRACT
    JPA -->|"SELECT d.*, a.*\nFROM document d\nJOIN appendix a\nON a.document_id = d.id"| APPENDIX

    style BASE fill:#2980B9,color:#fff
    style CONTRACT fill:#8E44AD,color:#fff
    style APPENDIX fill:#16A085,color:#fff
