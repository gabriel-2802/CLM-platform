# ==============================================================================
# PRODUCTION ENVIRONMENT
# This file is git-ignored. Never commit it.
#
# SWARM DEPLOYMENT (docker-stack.yml):
#   Sensitive values (DB_PASSWORD, JWT_SECRET, NEXTAUTH_SECRET,
#   ADMIN_REGISTER_CODE, MAIL_USERNAME, MAIL_PASSWORD, GRAFANA_PASSWORD)
#   are managed as Docker Swarm Secrets and are NOT read from this file.
#   See swarm.md § 4 for the docker secret create commands.
#
# CHECKLIST before running `docker stack deploy`:
#   [ ] FRONTEND_URL is your real public domain, e.g. https://clm.example.com
#   [ ] REGISTRY and IMAGE_TAG point to your built images
#   [ ] MAIL_* non-secret values are filled in (host, port, from address)
#   [ ] All Docker secrets have been created on the Swarm (see swarm.md § 4)
#   [ ] Node labels have been applied (see swarm.md § 3)
#   [ ] next.config.ts has output: "standalone" (already done by make setup-standalone)
# ==============================================================================

# --- Image registry (Swarm only) ---
# REQUIRED for docker stack deploy — images must be pre-built and pushed:
REGISTRY=registry.example.com/clm
IMAGE_TAG=latest

# --- Database (non-secret) ---
DB_USER=clm_user
DB_NAME=clm_platform
DB_PORT=5432
DB_USERS_NAME=clm_users
DB_CLIENTS_NAME=clm_clients
DB_NEGOTIATIONS_NAME=clm_negotiations

# --- JWT (non-secret) ---
JWT_EXPIRATION=2592000000

# --- Admin (non-secret) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Admin

# --- Mail / SMTP (non-secret — credentials are Docker secrets) ---
# REQUIRED — real SMTP provider (SendGrid, SES, Postmark, etc.):
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_EXPIRATION=86400000
NOTIFICATION_RECIPIENTS=

# --- Negotiation cron ---
# Default: 9am on the 1st of every month
NEGOTIATION_NOTIFICATION_CRON=0 0 9 1 * *

# --- Application URLs ---
# REQUIRED — your public domain, used for CORS + NextAuth + Grafana root URL:
FRONTEND_URL=
# Internal Docker network addresses — do not change:
CONTRACTS_SERVICE_URL=http://contracts:8081
NOTIFICATIONS_SERVICE_URL=http://notifications:8082

# --- Next.js Public API URLs (resolved in end-user browsers) ---
# These are baked into the frontend image at build time (see swarm.md § 2).
# Set them here as a reference for the build script, not for runtime injection.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CONTRACTS_API_URL=
NEXT_PUBLIC_NOTIFICATIONS_API_URL=
NEXT_PUBLIC_USER_SERVICE_URL=
NEXT_PUBLIC_CLIENT_SERVICE_URL=

# --- NextAuth (non-secret) ---
# NEXTAUTH_URL must match FRONTEND_URL:
NEXTAUTH_URL=

# --- Monitoring (non-secret) ---
GRAFANA_USER=admin

# --- LibreOffice ---
LIBREOFFICE_PATH=/usr/bin/libreoffice

# --- Spring / Node ---
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production

# --- Swarm ---
# IMAGE_PREFIX: trailing slash required, e.g. registry.example.com/clm/
IMAGE_PREFIX=registry.example.com/clm/
IMAGE_TAG=latest
# swagger-hub disabled in production
SWAGGER_HUB_REPLICAS=0
