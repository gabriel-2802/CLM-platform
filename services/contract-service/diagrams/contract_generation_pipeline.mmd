flowchart TD

    %% ── Entry point ──────────────────────────────────────────────
    A(["POST /api/contracts/generate"])

    %% ── Validation phase ─────────────────────────────────────────
    B["templateRepository.findById"]
    C{"template.isFullyMapped?"}
    D["validateMandatoryFields\ncheck all required fields have values"]
    E{"All mandatory\nfields present?"}

    %% ── Error exits ──────────────────────────────────────────────
    ERR1(["422 TemplateIncompleteException"])
    ERR2(["400 MissingMandatoryFieldException"])

    %% ── Entity creation ──────────────────────────────────────────
    F["generationMapper.toContractEntity\nstatus = PENDING_SIGNATURE"]

    %% ── Persistence — contract row ───────────────────────────────
    G[("contractRepository.save\npersists document + contract rows")]

    %% ── Audit log ────────────────────────────────────────────────
    H["documentGenerationUtil.buildFieldValues\ncreate DocumentFieldValue per TemplateField"]
    I[("fieldValueRepository.saveAll\nimmutable audit log written here")]

    %% ── DOCX filling ─────────────────────────────────────────────
    J["sort TemplateFields by fieldPosition\nbuildLabelValueMap: label → value"]
    K["FileUtils.decompress\nretrieve normalised DOCX bytes"]
    L["DocxFiller.fillDocx\nmerge runs · substituteEachWithSpans\nwritebackSpans · globalIndex tracks fields"]

    %% ── Conversion & compression ─────────────────────────────────
    M["FileUtils.convert\nDOCX → PDF via LibreOffice headless"]
    N["FileUtils.compress\nGZIP the PDF"]

    %% ── Persistence — final document ─────────────────────────────
    O[("contractRepository.save\ndocumentContent = compressed PDF\ndocumentFormat = PDF")]

    %% ── Success response ─────────────────────────────────────────
    P(["201 ContractResponseDTO\nwith audit fields + field value list"])

    %% ── Flow ─────────────────────────────────────────────────────
    A --> B
    B --> C
    C -->|No| ERR1
    C -->|Yes| D
    D --> E
    E -->|No| ERR2
    E -->|Yes| F
    F --> G
    G --> H
    H --> I
    I --> J
    J --> K
    K --> L
    L --> M
    M --> N
    N --> O
    O --> P

    %% ── Styles — CLM palette ─────────────────────────────────────
    %% Entry / success: semantic green/blue
    style A fill:#7eb8f7,stroke:#1a5fa8,color:#1a5fa8
    style P fill:#7dcfa0,stroke:#1a7f4e,color:#1a7f4e

    %% Errors: pastel red
    style ERR1 fill:#f4a8a8,stroke:#c45e1a,color:#7a1a1a
    style ERR2 fill:#f4a8a8,stroke:#c45e1a,color:#7a1a1a

    %% Persistence nodes: pastel purple
    style G fill:#c4a8f0,stroke:#6b3db5,color:#3d1a7a
    style O fill:#c4a8f0,stroke:#6b3db5,color:#3d1a7a

    %% Audit log: pastel orange (immutable / special)
    style I fill:#f4c07a,stroke:#c45e1a,color:#5a2a00

    %% Decision diamonds: light background, subtle border
    style C fill:#f8f9fc,stroke:#c9d1d9,color:#1c2128
    style E fill:#f8f9fc,stroke:#c9d1d9,color:#1c2128

    %% Process steps: plain white panel
    style B fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style D fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style F fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style H fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style J fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style K fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style L fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style M fill:#ffffff,stroke:#c9d1d9,color:#1c2128
    style N fill:#ffffff,stroke:#c9d1d9,color:#1c2128